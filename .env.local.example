# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-js-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key-server-only

# Google Maps Map IDs (create in Google Cloud Console -> Maps -> Map Management)
# Day theme Map ID — configure styles in Cloud Console for light/day appearance
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_DAY=your-day-map-id
# Night theme Map ID — configure styles in Cloud Console for dark/night appearance
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_NIGHT=your-night-map-id

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Admin
ADMIN_SECRET=your-admin-secret
